# Site URL - CRITICAL for OAuth
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: These are PUBLIC keys and safe to expose in the browser
# The anon key works with Row Level Security (RLS) to protect data
